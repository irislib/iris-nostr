{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "iris-nostr",
  "version": "0.2.1",
  "description": "Find public Nostr posts using social graph filters, Hashtree indexes and relays.",
  "author": {
    "name": "Sirius Business Ltd"
  },
  "repository": "https://github.com/irislib/iris-nostr",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/iris-nostr/SKILL.md",
      "interface": {
        "displayName": "Iris Nostr",
        "shortDescription": "Nostr discovery for agents",
        "developerName": "Sirius Business Ltd",
        "category": "Developer Tools",
        "websiteURL": "https://github.com/irislib/iris-nostr",
        "defaultPrompt": "Find relevant Nostr posts using my social graph."
      }
    }
  }
}
